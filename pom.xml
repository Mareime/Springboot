            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Lombok (évite d'écrire les getters/setters/constructeurs) -->
        <dependency>
            <groupId>org.projectlombok</groupId>
